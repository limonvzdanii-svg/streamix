{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"streamix",
  "main":"src/worker.js",
  "compatibility_date":"2026-11-20",
  "assets":{"directory":"./","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"streamix-db","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}]
}