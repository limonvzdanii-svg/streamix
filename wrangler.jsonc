{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamix",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamix-db",
      "migrations_dir": "migrations",
      "database_id": "9e1520af-601f-45f4-af64-90ef6ffa1042"
    }
  ]
}
